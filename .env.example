# SQLite database, relative to the prisma folder (creates prisma/dev.db).
DATABASE_URL="file:./dev.db"
PORT=3002

# AI provider for transcription / interpretation / story generation.
# Leave unset to run on mock/fallback output (safe for prototyping the loop).
# If both keys are set, OpenAI is used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5                      # optional override for interpretation / chapters / Guardian
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe # optional override for speech-to-text
# OPENAI_IMAGE_INPUTS_PER_MIN=5             # reference images your OpenAI account may send per minute
# GEMINI_API_KEY=

# Twilio Verify for sign-in codes. Leave unset to run sign-in in dev mode
# (the code is shown on screen instead of texted).
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=VA...

# Public address of the app, used for links inside text messages.
# APP_URL=http://localhost:5174

# Phone numbers that can open the admin panel, comma-separated (e.g. +15551234567).
# Leave empty only on your own computer: then anyone signed in can open it.
# ADMIN_PHONES=
