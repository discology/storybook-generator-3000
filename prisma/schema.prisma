// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  phone       String?   @unique
  email       String?   @unique
  name        String?
  contributors Contributor[]
  sessions    Session[]
  ownedHouseholds Household[]
  createdAt   DateTime  @default(now())
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model OtpCode {
  id         String   @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
}

model Household {
  id          String       @id @default(cuid())
  name        String?
  ownerUserId String?
  owner       User?        @relation(fields: [ownerUserId], references: [id])
  contributors Contributor[]
  children    Child[]
  invitations Invitation[]
  familyCharacters FamilyCharacter[]
  createdAt   DateTime     @default(now())
}

model Contributor {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  name        String
  phone       String?
  email       String?
  relationship String?  // e.g. "Mom", "Dad", "Grandma"
  role        String    @default("owner") // owner | contributor
  inviteStatus String   @default("joined") // joined | pending | revoked
  memories    Memory[]
  chapterAccess ChapterAccess[]
  chapterMarks ChapterMark[]
  feedback    StoryFeedback[]
  createdAt   DateTime  @default(now())
}

model Invitation {
  id              String    @id @default(cuid())
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  contributorId   String    @unique
  invitedByName   String?
  contact         String
  relationship    String?
  token           String    @unique
  status          String    @default("pending") // pending | accepted | revoked | expired
  renewRequestedAt DateTime? // the invitee asked for a fresh link
  createdAt       DateTime  @default(now())
  respondedAt     DateTime?
}

model Prompt {
  id             String   @id @default(cuid())
  question       String
  supportingText String?
  category       String   @default("General")
  audience       String   @default("Everyone")
  childStage     String   @default("All stages")
  cardColor      String   @default("purple")
  artworkPath    String? // square card artwork; Baby Vambie art is used when empty
  status         String   @default("published") // draft | published | archived
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

model ChapterAccess {
  chapterId     String
  contributorId String
  chapter       Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@id([chapterId, contributorId])
}

model GuardianFinding {
  id         String   @id @default(cuid())
  chapterId  String
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  category   String   // continuity | reader_fit | private_details | fidelity | tone
  status     String   @default("needs_revision") // needs_revision | ok
  note       String
  quote      String? // the exact words in the chapter this finding is about
  createdAt  DateTime @default(now())
}

model ExportRequest {
  id          String    @id @default(cuid())
  storybookId String
  storybook   Storybook @relation(fields: [storybookId], references: [id], onDelete: Cascade)
  status      String    @default("preparing") // preparing | ready | failed | expired
  filePath    String?
  contributorId String? // who asked for it; exports only hold what they may see
  options     String    @default("{}") // JSON: what to include and the date range
  error       String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

model Child {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  displayName String
  stage       String    @default("born") // "expecting" | "born"
  birthDate   DateTime?
  dueDate     DateTime?
  storybooks  Storybook[]
  createdAt   DateTime  @default(now())
}

model Storybook {
  id            String    @id @default(cuid())
  childId       String
  child         Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  title         String
  readerAgeBand String    @default("0-3") // explicit reading-level setting, separate from child's actual age
  growWithChild Boolean   @default(true) // if true, readerAgeBand advances automatically as the child ages
  language      String    @default("English")
  status        String    @default("active") // active | paused | archived
  reminderFrequency String @default("weekly") // weekly | daily
  reminderDay      String @default("Sunday")
  reminderTime     String @default("19:00")
  reminderTimezone String @default("Pacific Time")
  reminderChannel  String @default("SMS")
  remindersPaused  Boolean @default(false)
  remindersPausedUntil DateTime? // "Pause for 2 weeks"
  defaultVisibility String @default("contributor_only") // contributor_only | household
  defaultStoryUse   Boolean @default(true)
  keepRecordings    Boolean @default(true) // false: audio is deleted once it's transcribed
  vambieNameAge     Int     @default(4) // "Baby Vambie" is called just "Vambie" from this age
  // The week's memories become one chapter the morning after the weekly reminder.
  lastBatchAt       DateTime?
  pendingCastKeys   String  @default("[]") // JSON: Vambies picked for the next weekly chapter
  memories      Memory[]
  chapters      Chapter[]
  exportRequests ExportRequest[]
  createdAt     DateTime  @default(now())
}

model Memory {
  id               String    @id @default(cuid())
  storybookId      String
  storybook        Storybook @relation(fields: [storybookId], references: [id], onDelete: Cascade)
  contributorId    String
  contributor      Contributor @relation(fields: [contributorId], references: [id])
  title            String?
  eventDate        DateTime?
  recordedAt       DateTime  @default(now())
  audioUrl         String?
  durationSec      Int?
  visibility       String    @default("contributor_only") // contributor_only | household | story
  storyUseConsent  Boolean   @default(false)
  status           String    @default("recorded") // recorded | transcribing | transcribed | interpreted | ready | failed
  processingError  String?
  promptId         String? // the prompt card it answered
  promptText       String? // the question as it was worded then
  favoritedBy      String    @default("[]") // JSON: contributor ids who bookmarked it
  transcripts      TranscriptVersion[]
  interpretation   MemoryInterpretation?
  chapterSources   ChapterSource[]
  createdAt        DateTime  @default(now())
}

model TranscriptVersion {
  id         String   @id @default(cuid())
  memoryId   String
  memory     Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  source     String   // "machine" | "corrected"
  text       String
  createdAt  DateTime @default(now())
}

model MemoryInterpretation {
  id          String   @id @default(cuid())
  memoryId    String   @unique
  memory      Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  events      String? // short description of what happened
  emotions    String? // comma-separated or free text
  themes      String? // comma-separated or free text
  isMock      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Chapter {
  id          String   @id @default(cuid())
  storybookId String
  storybook   Storybook @relation(fields: [storybookId], references: [id], onDelete: Cascade)
  sequence    Int
  title       String
  content     String
  status      String   @default("draft") // draft | guardian_review | published
  guardianStatus String @default("not_reviewed") // not_reviewed | needs_revision | approved
  revisionRequested Boolean @default(false)
  version     Int      @default(1) // bumps on every full rewrite
  publishedAt DateTime?
  shareMode   String   @default("family") // family | selected | private (owner only)
  isMock      Boolean  @default(false)
  sources     ChapterSource[]
  findings    GuardianFinding[]
  access      ChapterAccess[]
  pages       StoryPage[]
  marks       ChapterMark[]
  feedback    StoryFeedback[]
  shares      ChapterShare[]
  // Page generation (empty for chapters created before illustrated pages existed).
  ruleSetVersion     Int?
  generationSnapshot String? // JSON: rules, reading profile and AI instructions used
  characterSheet     String? // JSON: [{ name, appearance }] reused in every illustration
  characterSheetImage String? // character reference picture used for every page's illustration
  pagesStatus        String  @default("none") // none | needs_characters | illustrating | ready | needs_attention
  unresolvedPeople   String? // JSON: people the planner couldn't match to a family character, awaiting the parent
  createdAt   DateTime @default(now())
}

model ChapterSource {
  chapterId String
  memoryId  String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  memory    Memory  @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@id([chapterId, memoryId])
}

// Admin-editable wording for outgoing text messages. Which types exist and which
// variables each supports is defined in server/messageTemplates.ts.
model MessageTemplate {
  key       String   @id // welcome | invite | reminder | chapter_ready
  body      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Admin-editable instructions sent to the AI at each step. Which steps exist and
// which variables each supports is defined in server/aiInstructions.ts.
model AiInstruction {
  key       String   @id // interpret | chapter | guardian
  body      String
  model     String? // OpenAI model override; null uses OPENAI_MODEL
  updatedAt DateTime @updatedAt
}

// Each save of the page rules in the admin panel creates a new version; chapters
// record the version they were generated with, so rule changes never alter them.
model GenerationRuleSet {
  id        String   @id @default(cuid())
  version   Int      @unique
  rules     String // JSON, see server/pageRules.ts
  createdAt DateTime @default(now())
}

model StoryPage {
  id                 String      @id @default(cuid())
  chapterId          String
  chapter            Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  pageNumber         Int
  storyMoment        String
  characters         String // JSON string[]
  setting            String
  visibleAction      String
  emotionalTone      String
  continuity         String
  shot               String? // JSON: { type, angle, focus }
  pictureSize        String      @default("") // vignette | framed | full | wordless; "" on pages made before sizes existed
  text               String // exact words shown beneath the illustration (empty on wordless pages)
  interpretationNote String
  sourceMemoryId     String?
  sourceQuote        String?
  checkStatus        String      @default("unchecked") // unchecked | ok | flagged
  checkNotes         String? // JSON string[]
  approvedAt         DateTime?
  assets             PageAsset[]
  appearances        PageAppearance[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([chapterId, pageNumber])
}

// Every illustration attempt for a page; the newest ready one is shown.
model PageAsset {
  id          String    @id @default(cuid())
  pageId      String
  page        StoryPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version     Int
  status      String // generating | ready | failed
  imagePath   String?
  prompt      String
  model       String?
  error       String?
  checkStatus String    @default("unchecked") // unchecked | ok | flagged
  checkNote   String?
  fixNote     String? // set when this version was drawn to correct a character who didn't match
  createdAt   DateTime  @default(now())
}

// Recurring characters (the Vambies) shared by every storybook. AI instructions
// reference them as <key>; each chapter snapshots the versions it was made with.
model Character {
  id             String         @id @default(cuid())
  key            String         @unique // variable name: baby_vambie → <baby_vambie>; never changes
  name           String
  group          String?
  storyRole      String         @default("") // what they do in stories
  personality    String         @default("") // how they act and speak
  appearance     String         @default("") // locked look used in every illustration
  neverRules     String         @default("") // what must never change or appear
  castingMode    String         @default("when_it_fits") // always | when_it_fits | only_when_picked
  castingNotes   String         @default("") // when a story should include them
  status         String         @default("draft") // draft | active | retired
  version        Int            @default(1) // bumps when the card or reference art changes
  referenceArtId String?
  importedFrom   String? // e.g. "voot:baby-vambie"
  art            CharacterArt[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// Uploaded or generated artwork; the character's reference art is attached to
// every illustration they appear in.
model CharacterArt {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  imagePath   String
  source      String // upload | generated | render
  prompt      String?
  // Official 3D renders: which camera view and facial expression this image
  // shows, so illustrations can attach the one matching each page.
  view        String? // front | angle | side
  expression  String? // happy | sad | excited | angry | surprised | in_love | amused
  artSet      String    @default("") // "" for the character's usual look, or e.g. "with guitar"
  fileHash    String? // to recognize the same image uploaded twice
  createdAt   DateTime  @default(now())
}

// People (and pets) in a family's stories. Each has a permanent ID; how they
// look lives in approved, versioned designs, one line of versions per age variant.
model FamilyCharacter {
  id           String            @id @default(cuid())
  householdId  String
  household    Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name         String // e.g. "Grandma Rose"
  relationship String            @default("") // to the child, e.g. "Grandmother (Mom's mother)"
  aliases      String            @default("[]") // JSON string[]: what people call them, e.g. ["Grandma", "Nana"]
  context      String            @default("") // details that tell them apart from others with the same alias
  designs      CharacterDesign[]
  appearances  PageAppearance[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// One version of a character's look for one age variant. Approved designs are
// never edited: a change creates a new version, so pages that used the old one keep it.
model CharacterDesign {
  id                String           @id @default(cuid())
  familyCharacterId String
  familyCharacter   FamilyCharacter  @relation(fields: [familyCharacterId], references: [id], onDelete: Cascade)
  variant           String           @default("today") // e.g. "today", "as a child"
  version           Int // per character and variant
  status            String           @default("draft") // draft | approved | superseded
  identity          String           @default("") // fixed features: face, skin tone, eyes, hair, build, signature accessories
  usualClothing     String           @default("") // a typical outfit; scenes may dress them differently
  changeNote        String           @default("") // what this version changes from the last
  styleSnapshot     String           @default("") // illustration style when approved
  photoPath         String? // private reference photo: never served publicly or sent with page illustrations
  portraitPath      String? // the approved design picture
  sheetPath         String? // turnaround and expressions reference sheet
  sheetStatus       String           @default("none") // none | generating | ready | failed
  approvedAt        DateTime?
  proposals         DesignProposal[]
  appearances       PageAppearance[]
  createdAt         DateTime         @default(now())
}

model DesignProposal {
  id        String          @id @default(cuid())
  designId  String
  design    CharacterDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  imagePath String
  createdAt DateTime        @default(now())
}

// Which design of a family character appears on a page, and how they're dressed there.
model PageAppearance {
  id                String          @id @default(cuid())
  pageId            String
  page              StoryPage       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  familyCharacterId String
  familyCharacter   FamilyCharacter @relation(fields: [familyCharacterId], references: [id], onDelete: Cascade)
  designId          String
  design            CharacterDesign @relation(fields: [designId], references: [id])
  outfit            String          @default("")
  details           String          @default("")

  @@unique([pageId, familyCharacterId])
}

// Per reader: bookmarked ("favorite") chapters and where they left off.
model ChapterMark {
  id            String      @id @default(cuid())
  chapterId     String
  chapter       Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  contributorId String
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  favorite      Boolean     @default(false)
  lastPage      Int         @default(0)
  readAt        DateTime? // first opened
  finishedAt    DateTime?

  @@unique([chapterId, contributorId])
}

// "For grown-ups: story feedback" from the reader; shows in admin Story Review.
model StoryFeedback {
  id            String      @id @default(cuid())
  chapterId     String
  chapter       Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  contributorId String
  contributor   Contributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  reason        String // missed_meaning | too_private | reading_level | wrong_detail
  note          String      @default("")
  status        String      @default("open") // open | resolved
  createdAt     DateTime    @default(now())
}

// A chapter link sent to family members (with an optional note).
model ChapterShare {
  id             String   @id @default(cuid())
  chapterId      String
  chapter        Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sentBy         String // contributor id
  recipientIds   String // JSON: contributor ids
  message        String   @default("")
  createdAt      DateTime @default(now())
}
